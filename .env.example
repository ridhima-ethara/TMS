# Copy these names into .env.local. Never put a real IP, hostname or API key in this tracked example.
# Use a dedicated non-superuser database role for the application.
DATABASE_URL=postgresql://ticketflow_app@localhost/ticketflow_local
PG_POOL_MAX=20
# Database TLS: disable | require | verify-ca | verify-full.
# Defaults to verify-full when NODE_ENV=production and the host is not loopback,
# and to disable otherwise. A remote database in production cannot use disable.
# `sslmode` inside DATABASE_URL is ignored -- set the mode here instead.
DATABASE_SSL=verify-full
# CA bundle used to authenticate the database server. Required for verify-ca and
# verify-full in production. On RDS, download the Amazon root bundle:
#   curl -o /etc/ssl/certs/rds-global-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DATABASE_CA_CERT_PATH=/etc/ssl/certs/rds-global-bundle.pem
JWT_SECRET=replace-with-at-least-32-random-bytes
# Email verification defaults to required in production and disabled in development.
EMAIL_VERIFICATION_REQUIRED=true
# Public origin users reach the app on. Anchors email verification links and the
# cross-site mutation allowlist. Must be https:// unless it is a loopback host in
# development; a wrong value breaks verification email links.
PUBLIC_APP_URL=https://service-hub.example.com
# Keep true/default in production. Set false only for an explicitly accepted
# plain-http deployment where browsers must retain login cookies.
SESSION_COOKIE_SECURE=true
# Development fixture loading is disabled unless explicitly enabled. Never enable in production.
ALLOW_DATABASE_SEED=false
# Demo fixtures are denied at login by default, including in production.
ALLOW_DEMO_LOGIN=false
SEED_DEMO_BUSINESS_DATA=false
# Required only when fixture loading is deliberately enabled in development.
# Use a unique 12+ character value; never reuse a real account password.
SEED_DEMO_PASSWORD=
# Enable only behind a trusted proxy that overwrites X-Forwarded-* headers.
TRUST_PROXY=false

# SMTP transport used by login OTPs, approvals, SLA escalations and all other
# email notifications. Port 587 uses STARTTLS; port 465 uses implicit TLS.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=service-hub@your-domain.example
SMTP_PASS=replace-locally-only
# Optional private CA for a trusted internal SMTP relay.
SMTP_CA_CERT_PATH=

# Alternative transport: set EMAIL_TRANSPORT=resend to use this API key.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=TicketFlow <tickets@your-verified-domain.example>
# Set true after RESEND_API_KEY and MAIL_FROM are configured. Passwords are
# validated first, then a one-time code is emailed before a session is issued.
LOGIN_OTP_REQUIRED=true
# Set false only when in-app notifications must not also be delivered by email.
EMAIL_NOTIFICATIONS_ENABLED=true
# Persistent Node deployments retry the queued outbox on this interval.
EMAIL_DELIVERY_INTERVAL_MS=30000
# Optional Resend-compatible endpoint override (for a trusted email proxy/test server).
RESEND_API_URL=https://api.resend.com/emails
# Optional bearer token for a deployment scheduler calling POST /api/sla/process.
SLA_CRON_SECRET=replace-with-an-independent-random-secret

# Configure both locations explicitly. Never point HQ and HQ2 at the same
# appliance or reuse one location's token for the other.
FIREWALL_HQ_API_URL=https://hq-firewall-host-or-ip
FIREWALL_HQ_API_KEY=replace-locally-only
FIREWALL_HQ_NAME=HQ Firewall
FIREWALL_HQ2_API_URL=https://hq2-firewall-host-or-ip
FIREWALL_HQ2_API_KEY=replace-locally-only
FIREWALL_HQ2_NAME=HQ2 Firewall
# Shared connector settings and endpoint paths follow.
FIREWALL_API_HEADER=Authorization
FIREWALL_API_PREFIX=Bearer

# Preferred: trust the firewall's private CA certificate.
FIREWALL_CA_CERT_PATH=/absolute/path/to/firewall-ca.pem
# Alternative for an appliance that omits its private CA chain: pin the
# independently verified leaf-certificate SHA-256 fingerprint.
FIREWALL_CERT_SHA256=AA:BB:CC:replace-with-the-verified-32-byte-fingerprint
# Temporary fallback for a self-signed appliance certificate (connector requests only).
FIREWALL_ALLOW_SELF_SIGNED=false

# Override these paths to match the firewall vendor API.
FIREWALL_STATUS_PATH=/api/v2/monitor/system/status
FIREWALL_CONFIG_PATH=/api/v2/cmdb/system/global
FIREWALL_STATISTICS_PATH=/api/v2/monitor/system/resource/usage
FIREWALL_DEVICES_PATH=/api/v2/monitor/user/device/query
FIREWALL_VPN_PATH=/api/v2/monitor/vpn/ipsec
FIREWALL_INTERFACES_PATH=/api/v2/monitor/system/interface/select
FIREWALL_POLICIES_PATH=/api/v2/cmdb/firewall/policy
FIREWALL_LOGS_PATH=/api/v2/log/memory/traffic/forward
FIREWALL_LOG_ROWS=1000
# FortiGate Application Control logs contain firewall-identified application,
# category and risk fields. Traffic logs alone may only contain service/ports.
FIREWALL_APPLICATION_PATH=/api/v2/log/memory/app-ctrl
FIREWALL_APPLICATION_PAGE_ROWS=5000
FIREWALL_APPLICATION_MAX_ROWS=20000
# Reject unexpectedly large upstream responses before they exhaust Node memory.
FIREWALL_MAX_RESPONSE_BYTES=26214400
# Persist a complete retained-traffic snapshot independently of dashboard use.
# Each outage references the last successful snapshot captured before downtime.
FIREWALL_ARCHIVE_INTERVAL_MS=900000
FIREWALL_ARCHIVE_INITIAL_DELAY_MS=30000
FIREWALL_ARCHIVE_PAGE_ROWS=10000
FIREWALL_ARCHIVE_SYNC_MAX_ROWS=100000
FIREWALL_ARCHIVE_MAX_RECORDS=50000
# Maximum appliance-verified saved rows returned to the dashboard when the
# live current-period traffic feed is empty or unavailable.
FIREWALL_FALLBACK_MAX_ROWS=25000
FIREWALL_EVENTS_PATH=/api/v2/log/memory/event/system
FIREWALL_ANTIVIRUS_PATH=/api/v2/log/memory/virus
FIREWALL_IPS_PATH=/api/v2/log/memory/ips
FIREWALL_WEBFILTER_PATH=/api/v2/log/memory/webfilter
FIREWALL_DNSFILTER_PATH=/api/v2/log/memory/dns
